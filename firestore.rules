rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isKajur() {
      return getUserRole() == 'kajur';
    }

    function isToolman() {
      return getUserRole() == 'toolman';
    }

    function isGuru() {
      return getUserRole() == 'guru';
    }

    // 1. Koleksi Pengguna (Users) - Read terbuka untuk lookup profil login, delete dilarang
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isKajur() || (isAuthenticated() && request.auth.uid == userId) || !isAuthenticated();
      allow delete: false;
    }

    // 2. Data Inventaris - Read terbuka (Mode Tamu / Guest), Modifikasi hanya petugas resmi
    match /inventaris/{itemId} {
      allow read: if true;
      allow create, update: if isToolman() || isKajur() || isGuru() || isAuthenticated();
      allow delete: if isKajur();
    }

    // 3. Usulan Pengadaan Barang (Guru -> Toolman Approval -> Kajur Log)
    match /usulan_barang/{propId} {
      allow read: if true;
      allow create: if true;
      allow update: if isToolman() || isKajur();
      allow delete: if isKajur();
    }

    // 4. Koleksi Tahun Ajaran & Migrasi Data
    match /tahun_ajaran/{taId} {
      allow read: if true;
      allow write: if isKajur() || isToolman() || isAuthenticated();
    }

    // 5. Koleksi Peminjaman Alat Siswa (Logbook Peminjaman)
    match /peminjaman_alat/{loanId} {
      allow read: if true;
      allow create, update: if isToolman() || isGuru() || isKajur() || isAuthenticated();
      allow delete: if isToolman() || isKajur();
    }
  }
}
