rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isKajur() {
      return isAuthenticated() && getUserRole() == 'kajur';
    }

    function isToolman() {
      return isAuthenticated() && getUserRole() == 'toolman';
    }

    function isGuru() {
      return isAuthenticated() && getUserRole() == 'guru';
    }

    // 1. Koleksi Pengguna (Users) - Akun terlindungi & tidak dapat dihapus
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isKajur() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: false;
    }

    // 2. Data Inventaris (Sesuai Kolom Excel)
    match /inventaris/{itemId} {
      allow read: if isAuthenticated();
      // Toolman & Kajur bisa tambah & edit data barang
      allow create, update: if isToolman() || isKajur();
      // Hanya Kajur yang berwenang menghapus data barang (Pemutihan Aset)
      allow delete: if isKajur();
    }

    // 3. Usulan Pengadaan Barang (Guru -> Toolman Approval -> Kajur Log)
    match /usulan_barang/{propId} {
      allow read: if isAuthenticated();
      // Guru, Toolman, dan Kajur bisa membuat usulan
      allow create: if isAuthenticated();
      // Toolman & Kajur berwenang melakukan Review & Approval
      allow update: if isToolman() || isKajur();
      allow delete: if isKajur();
    }

    // 4. Koleksi Tahun Ajaran & Migrasi Data
    match /tahun_ajaran/{taId} {
      allow read: if isAuthenticated();
      allow write: if isKajur() || isToolman();
    }

    // 5. Koleksi Peminjaman Alat Siswa (Logbook Peminjaman)
    match /peminjaman_alat/{loanId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isToolman() || isKajur();
    }
  }
}
